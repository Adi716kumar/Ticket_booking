<%- include("../partials/header") %>

<%- include("../partials/navbar") %>

<div class="container mt-4">

    <h2><%= event.title %></h2>

    <hr>

    <h4 class="mt-3 text-warning">
    Premium Seats (₹<%= event.pricing.Premium %>)
</h4>

<div class="row">

    <% seats.forEach(seat => { %>

        <% if(seat.category === "Premium"){ %>

            <div class="col-1 mb-3">

                <button
                    class="btn w-100 seat-btn
                    <% if(seat.status==='Available'){ %> btn-success <% } %>
                    <% if(seat.status==='Held'){ %> btn-warning <% } %>
                    <% if(seat.status==='Booked'){ %> btn-danger <% } %>"
                    data-id="<%= seat._id %>"
                    <% if(seat.status!=='Available'){ %> disabled <% } %>>

                    <%= seat.seat.seatNumber %>

                </button>

            </div>

        <% } %>

    <% }) %>

</div>

<% if (premiumAvailable === 0) { %>

    <div class="alert alert-warning mt-3">

        Premium seats are sold out.

        <button
            id="premiumWaitlistBtn"
            class="btn btn-warning ms-3">

            Join Premium Waitlist

        </button>

    </div>

<% } %>

<hr>

<h4 class="mt-4 text-primary">
    Standard Seats (₹<%= event.pricing.Standard %>)
</h4>

<div class="row">

    <% seats.forEach(seat => { %>

        <% if(seat.category === "Standard"){ %>

            <div class="col-1 mb-3">

                <button
                    class="btn w-100 seat-btn
                    <% if(seat.status==='Available'){ %> btn-success <% } %>
                    <% if(seat.status==='Held'){ %> btn-warning <% } %>
                    <% if(seat.status==='Booked'){ %> btn-danger <% } %>"
                    data-id="<%= seat._id %>"
                    <% if(seat.status!=='Available'){ %> disabled <% } %>>

                    <%= seat.seat.seatNumber %>

                </button>

            </div>

        <% } %>

    <% }) %>

</div>

<% if (standardAvailable === 0) { %>

    <div class="alert alert-warning mt-3">

        Standard seats are sold out.

        <button
            id="standardWaitlistBtn"
            class="btn btn-warning ms-3">

            Join Standard Waitlist

        </button>

    </div>

<% } %>

<hr />

<div class="mt-4">

    <h5>Seat Legend</h5>

    <span class="badge bg-success me-2">
        Available
    </span>

    <span class="badge bg-primary me-2">
        Selected
    </span>

    <span class="badge bg-warning text-dark me-2">
        Held
    </span>

    <span class="badge bg-danger">
        Booked
    </span>

</div>

    <button
        id="holdBtn"
        class="btn btn-primary mt-4">

        Hold Selected Seats

    </button>
    
    <button
    id="bookBtn"
    class="btn btn-success mt-4 ms-2">

    Book Selected Seats

</button>

</div>
<script>
    const EVENT_ID = "<%= event._id %>";
</script>

<script src="/js/seatMap.js"></script>


<%- include("../partials/footer") %>