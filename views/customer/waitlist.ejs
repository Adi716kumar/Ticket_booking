<%- include("../partials/header") %>

<%- include("../partials/navbar") %>

<div class="container mt-5">

    <h2>My Waitlist</h2>

    <hr>

    <% if(waitlists.length === 0){ %>

        <div class="alert alert-info">

            You are not in any waitlist.

        </div>

    <% } else { %>

        <% waitlists.forEach(waitlist => { %>

            <div class="card shadow mb-4">

                <div class="card-header d-flex justify-content-between">

                    <strong>
                        <%= waitlist.event.title %>
                    </strong>

                    <% if(waitlist.status === "Waiting"){ %>

                        <span class="badge bg-warning text-dark">
                            Waiting
                        </span>

                    <% } %>

                    <% if(waitlist.status === "Offered"){ %>

                        <span class="badge bg-success">
                            Offered
                        </span>

                    <% } %>

                    <% if(waitlist.status === "Booked"){ %>

                        <span class="badge bg-primary">
                            Booked
                        </span>

                    <% } %>

                    <% if(waitlist.status === "Expired"){ %>

                        <span class="badge bg-danger">
                            Expired
                        </span>

                    <% } %>

                </div>

                <div class="card-body">

                    <p>

                        <strong>Category :</strong>

                        <%= waitlist.category %>

                    </p>

                    <% if(waitlist.status === "Offered"){ %>

                        <p>

                            <strong>Seats Offered :</strong>

                            <% waitlist.offeredSeats.forEach(seat => { %>

                                <span class="badge bg-info text-dark">

                                    <%= seat.seat.seatNumber %>

                                </span>

                            <% }) %>

                        </p>

                        <form
                            action="/api/waitlist/accept"
                            method="POST">

                            <input
                                type="hidden"
                                name="waitlistId"
                                value="<%= waitlist._id %>">

                            <% waitlist.offeredSeats.forEach(seat => { %>

                                <input
                                    type="hidden"
                                    name="seatIds"
                                    value="<%= seat._id %>">

                            <% }) %>

                            <button
                                class="btn btn-success">

                                Accept Offer

                            </button>

                        </form>

                    <% } %>

                </div>

            </div>

        <% }) %>

    <% } %>

</div>

<%- include("../partials/footer") %>