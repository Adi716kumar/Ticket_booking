<%- include("../partials/head", { pageTitle: "Organizer Dashboard" }) %>
<%- include("../partials/navbar") %>

<div class="container" style="margin-top:32px;">
  <div style="display:flex; justify-content:space-between; align-items:center;">
    <h1>Your Events</h1>
    <a href="/organizer/events/new" class="btn btn-primary">+ Create Event</a>
  </div>

  <% if (events.length === 0) { %>
    <div class="empty-state">You haven't created any events yet.</div>
  <% } else { %>
    <table class="data-table">
      <thead>
        <tr><th>Title</th><th>Venue</th><th>Date</th><th>Status</th><th></th></tr>
      </thead>
      <tbody>
        <% events.forEach(function(evt) { %>
          <tr>
            <td><%= evt.title %></td>
            <td><%= evt.venue.name %></td>
            <td><%= new Date(evt.date).toLocaleDateString() %> <%= evt.startTime %></td>
            <td><span class="badge badge-confirmed"><%= evt.status %></span></td>
            <td><a href="/organizer/events/<%= evt._id %>/stats" class="btn btn-ghost">View Stats</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include("../partials/footer") %>
