<%- include("../partials/head", { pageTitle: "Create Event" }) %>
<%- include("../partials/navbar") %>

<div class="container">
  <div class="panel form-panel">
    <h2>Create Event</h2>
    <form id="createEventForm">
      <div class="form-group">
        <label>Title</label>
        <input type="text" name="title" required />
      </div>
      <div class="form-group">
        <label>Type</label>
        <select name="type" required>
          <option value="Movie">Movie</option>
          <option value="Concert">Concert</option>
        </select>
      </div>
      <div class="form-group">
        <label>Venue</label>
        <select name="venueId" required>
          <% venues.forEach(function(v) { %>
            <option value="<%= v._id %>"><%= v.name %> — <%= v.location %></option>
          <% }) %>
        </select>
      </div>
      <div class="row-2">
        <div class="form-group">
          <label>Date</label>
          <input type="date" name="date" required />
        </div>
        <div class="form-group">
          <label>Start Time</label>
          <input type="time" name="startTime" required />
        </div>
      </div>
      <div class="form-group">
        <label>Duration (minutes)</label>
        <input type="number" name="durationMinutes" value="180" min="30" />
      </div>
      <div class="row-2">
        <div class="form-group">
          <label>Premium Price (₹)</label>
          <input type="number" name="premiumPrice" min="0" required />
        </div>
        <div class="form-group">
          <label>Standard Price (₹)</label>
          <input type="number" name="standardPrice" min="0" required />
        </div>
      </div>
      <div class="form-error" id="formError"></div>
      <button type="submit" class="btn btn-primary" style="width:100%;">Create Event</button>
    </form>
  </div>
</div>

<script>
  document.getElementById("createEventForm").addEventListener("submit", async (e) => {
    e.preventDefault();
    const f = new FormData(e.target);
    const res = await fetch("/api/events", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        title: f.get("title"),
        type: f.get("type"),
        venueId: f.get("venueId"),
        date: f.get("date"),
        startTime: f.get("startTime"),
        durationMinutes: f.get("durationMinutes"),
        pricing: { Premium: f.get("premiumPrice"), Standard: f.get("standardPrice") },
      }),
    });
    const data = await res.json();
    if (data.success) {
      window.location.href = "/dashboard";
    } else {
      document.getElementById("formError").innerText = data.message;
    }
  });
</script>

<%- include("../partials/footer") %>
