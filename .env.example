# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/ticket_booking

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Seat hold / waitlist offer time-to-live (in minutes)
SEAT_HOLD_TTL_MINUTES=10
WAITLIST_OFFER_TTL_MINUTES=10

# Email (any SMTP provider works, e.g. Gmail App Password, Mailtrap, Brevo)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Ticket Booking" <no-reply@ticketbooking.com>

# Optional: Anthropic API key for natural-language event search.
# If unset, search falls back to a built-in rule-based parser (no external call).
ANTHROPIC_API_KEY=
